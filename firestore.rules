rules_version = '2';
// Bulletin board for rayhan's portfolio — pins/{id}: { img, uid, r, ts }
// Paste in Firebase console → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{db}/documents {
    match /pins/{id} {
      allow read: if true;                                  // wall is public
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;   // pin under your own anonymous uid
      allow update: if false;
      allow delete: if request.auth != null
        && (resource.data.uid == request.auth.uid           // authors remove their own
            || resource.data.ts < request.time - duration(7, 'd')); // anyone may clear pins older than 7 days
    }
  }
}
